NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOURPASSWORD

# --- TEXT MODEL (Mistral for Graph Extraction) ---
LOCAL_LLM_MODEL=models\Mistral-7B-Instruct-v0.1-GGUF
LOCAL_LLM_FILE=mistral-7b-instruct-v0.1.Q4_K_M.gguf
LOCAL_N_CTX=8192
LOCAL_N_GPU_LAYERS=40

# --- VISION MODEL (LLAVA) ---
LOCAL_LLAVA_MODEL=models\vision\llava-v1.6-mistral-7b.Q4_K_M.gguf
LOCAL_LLAVA_CLIP=models\vision\mmproj-model-f16.gguf
LOCAL_LLAVA_CTX=4096
LOCAL_LLAVA_GPU_LAYERS=100

# --- YOLO CONFIG (Segmentation) ---
YOLO_MODEL_FILE=models\yolo\yolov8m-seg.pt
YOLO_CONFIDENCE=0.25
YOLO_VERBOSE=0
YOLO_DOC_FILE =models\yolo\yolov8x-doclaynet.pt
LEIDEN_RESOLUTION=0.5
RETRIEVAL_SEARCH_LIMIT=10
RUN_RELATION_EXTRACTION=TRUE
NEO4J_QUERY_LIMIT = 100

LOCAL_N_CTX=8192

GEMINI_API_KEY=YOURAPIKEY
